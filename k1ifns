local function AimRenderStep()
    if not AimActive then
        return
    end

    Camera = Workspace.CurrentCamera
    FrameNow = os.clock()
    SyncAimSettings()
    RefreshPing(FrameNow)
    RefreshMe()
    UpdateAimPoint()
    DrawFov()

    if not AimHolding then
        return
    end

    local _, aimPos = GetAimTarget()
    if aimPos then
        AimAt(aimPos)
    end
end

