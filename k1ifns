local InfJumpConnection
local InfJumpGamepadHeld = false

local function IsGamepadJumpDown()
    if InfJumpGamepadHeld then
        return true
    end

    for _, inputType in ipairs(UserInputService:GetConnectedGamepads()) do
        local ok, down = pcall(function()
            return UserInputService:IsGamepadButtonDown(inputType, Enum.KeyCode.ButtonA)
        end)
        if ok and down then
            return true
        end
    end

    -- Fallback for executors where IsKeyDown still works for pads
    if UserInputService:IsKeyDown(Enum.KeyCode.ButtonA) then
        return true
    end

    return false
end

local function IsInfJumpHeld()
    return UserInputService:IsKeyDown(Enum.KeyCode.Space) or IsGamepadJumpDown()
end

local function DisableInfJump()
    if InfJumpConnection then
        InfJumpConnection:Disconnect()
        InfJumpConnection = nil
    end
    InfJumpGamepadHeld = false
end

local function EnableInfJump()
    DisableInfJump()

    InfJumpConnection = RunService.Heartbeat:Connect(function()
        if not Options.InfJump or not Options.InfJump.Value then
            return
        end

        if not IsInfJumpHeld() then
            return
        end

        local character = LocalPlayer.Character
        if not character then
            return
        end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local root = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
        if not humanoid or not root or humanoid.Health <= 0 then
            return
        end

        local state = humanoid:GetState()
        if state == Enum.HumanoidStateType.Seated or state == Enum.HumanoidStateType.Dead then
            return
        end

        local jumpPower = 50
        if humanoid.UseJumpPower then
            jumpPower = humanoid.JumpPower
        elseif humanoid.JumpHeight > 0 then
            jumpPower = math.sqrt(2 * Workspace.Gravity * humanoid.JumpHeight)
        end

        if root.AssemblyLinearVelocity.Y < jumpPower * 0.9 then
            root.AssemblyLinearVelocity = Vector3.new(
                root.AssemblyLinearVelocity.X,
                jumpPower,
                root.AssemblyLinearVelocity.Z
            )
        end
    end)
end

