local function GetExecutorFn(name)
    local sources = {getgenv and getgenv(), _G, shared}
    for i = 1, #sources do
        local env = sources[i]
        if type(env) == "table" and typeof(env[name]) == "function" then
            return env[name]
        end
    end
    return nil
end

local MouseRel = GetExecutorFn("mousemoverel") or GetExecutorFn("MouseMoveRel")

local function MoveMouse(dx, dy)
    if MouseRel then
        pcall(MouseRel, dx, dy)
    elseif Vim then
        pcall(Vim.SendMouseMoveDeltaEvent, Vim, dx, dy, nil)
    end
end

local function MoveCamera(aimPos, alpha)
    local cf = Camera.CFrame
    Camera.CFrame = cf:Lerp(CFrame.lookAt(cf.Position, aimPos), alpha)
end

local HISTORY = 6
local PosHistory = {}
local CachedPing = 60
local PingClock = 0
local Clamp = math.clamp
local Sqrt = math.sqrt
local Huge = math.huge
local MaxVel = 100

local function RefreshPing(now)
    if now - PingClock < 0.75 then
        return
    end
    PingClock = now
    local ok, ping = pcall(function()
        return Stats.PerformanceStats.Ping:GetValue()
    end)
    if ok and typeof(ping) == "number" then
        CachedPing = Clamp(ping, 20, 300)
    end
end

local function GetHist(plr)
    local h = PosHistory[plr]
    if h then
        return h
    end
    h = {
        n = 0,
        i = 0,
        t = table.create(HISTORY),
        p = table.create(HISTORY),
        smoothVel = Vector3.zero,
        smoothAccel = Vector3.zero,
        smoothAim = nil,
    }
    PosHistory[plr] = h
    return h
end

local function PushHist(plr, pos, now)
    local h = GetHist(plr)
    local prevI = h.i
    local i = prevI % HISTORY + 1
    h.i = i
    h.n = math.min(h.n + 1, HISTORY)
    h.t[i] = now
    h.p[i] = pos
    return h, prevI, i
end

local function AvgVelocity(h)
    if h.n < 2 then
        return Vector3.zero
    end
    local oldest = h.i - h.n + 1
    if oldest < 1 then
        oldest += HISTORY
    end
    local dt = h.t[h.i] - h.t[oldest]
    if dt < 1e-3 then
        return Vector3.zero
    end
    return (h.p[h.i] - h.p[oldest]) / dt
end

local function PredictPos(plr, part, dist, now)
    local raw = part.Position
    if not PredictionEnabled or PredictionStrength <= 0 then
        return raw
    end

    local h = PushHist(plr, raw, now)
    if h.n < 3 then
        h.smoothAim = raw
        return raw
    end

    local histVel = AvgVelocity(h)
    local partVel = part.AssemblyLinearVelocity
    if partVel.Magnitude < 0.05 then
        partVel = part.Velocity
    end
    local vel = histVel:Lerp(partVel, 0.35)

    h.smoothVel = h.smoothVel:Lerp(vel, 0.25)
    vel = h.smoothVel

    local speed = vel.Magnitude
    if speed > MaxVel then
        vel = vel * (MaxVel / speed)
        speed = MaxVel
        h.smoothVel = vel
    end

    local instantAccel = (vel - (h._lastVel or vel)) / math.max(now - (h._lastT or now), 1e-3)
    h._lastVel = vel
    h._lastT = now
    h.smoothAccel = h.smoothAccel:Lerp(instantAccel, 0.12)
    local accel = h.smoothAccel
    local aMag = accel.Magnitude
    if aMag > 80 then
        accel = accel * (80 / aMag)
    end
    if vel:Dot(accel) < 0 then
        accel = Vector3.zero
    end

    local t = CachedPing * 0.00055
    t += Clamp(dist / 550, 0, 0.06)
    t += Clamp(speed / 280, 0, 0.04)
    t = Clamp(t, 0.015, 0.14) * Clamp(PredictionStrength, 0, 1)

    local predicted = raw + vel * t + accel * (0.35 * t * t)
    if h.smoothAim then
        predicted = h.smoothAim:Lerp(predicted, 0.4)
    end
    h.smoothAim = predicted
    return predicted
end

