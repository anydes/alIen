local function SyncAimSettings()
    local mode = Options.AimMode and Options.AimMode.Value or "Camera"
    AimMode = string.lower(mode)
    Smoothness = Options.AimSmoothness and Options.AimSmoothness.Value or 1
    FovRadius = Options.AimFovRadius and Options.AimFovRadius.Value or 160
    ShowFov = Options.ShowFov and Options.ShowFov.Value or false
    MaxAimDistance = Options.AimMaxDistance and Options.AimMaxDistance.Value or 350
    VisibilityCheck = Options.VisibilityCheck and Options.VisibilityCheck.Value or false
end

local function UpdateAimPoint()
    if AimMode == "mouse" then
        local ok, m = pcall(UserInputService.GetMouseLocation, UserInputService)
        if ok and m then
            CachedAimPoint = m
            return
        end
    end
    local s = Camera.ViewportSize
    CachedAimPoint = Vector2.new(s.X * 0.5, s.Y * 0.5)
end

local function FovAt(locked)
    return locked and (FovRadius + StickyFovBonus) or FovRadius
end

local function IsValidAimTarget(plr, needFov)
    if plr == LocalPlayer then
        return false
    end
    if TeamCheck and plr.Team == LocalPlayer.Team then
        return false
    end

    local char = plr.Character
    if not char or not MyRoot then
        return false
    end

    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    local part = char:FindFirstChild(TargetPart)
    if not root or not hum or not part or hum.Health <= 0 then
        return false
    end

    local dist = (root.Position - MyRoot.Position).Magnitude
    if dist > MaxAimDistance then
        return false
    end

    local aimPos = PredictPos(plr, part, dist, FrameNow)
    local screen, onScreen = Camera:WorldToViewportPoint(aimPos)
    if not onScreen or screen.Z <= 0 then
        return false
    end

    if VisibilityCheck then
        AimRayParams.FilterDescendantsInstances = {Camera, MyChar, char}
        local hit = Workspace:Raycast(Camera.CFrame.Position, aimPos - Camera.CFrame.Position, AimRayParams)
        if hit and not hit.Instance:IsDescendantOf(char) then
            return false
        end
    end

    local screenDist = (Vector2.new(screen.X, screen.Y) - CachedAimPoint).Magnitude
    if needFov and screenDist > FovAt(plr == LockedTarget) then
        return false
    end

    return true, aimPos, screenDist
end

local function GetAimTarget()
    if StickyAim and LockedTarget then
        local ok, pos = IsValidAimTarget(LockedTarget, true)
        if ok then
            return LockedTarget, pos
        end
        LockedTarget = nil
    end

    local best, bestPos, bestDist = nil, nil, Huge
    local list = Players:GetPlayers()
    for i = 1, #list do
        local plr = list[i]
        local ok, pos, screenDist = IsValidAimTarget(plr, true)
        if ok and screenDist < bestDist then
            best, bestPos, bestDist = plr, pos, screenDist
        end
    end

    if StickyAim then
        LockedTarget = best
    end
    return best, bestPos
end

local function AimAt(aimPos)
    local screen, on = Camera:WorldToViewportPoint(aimPos)
    if not on or screen.Z <= 0 then
        return
    end

    local errX = screen.X - CachedAimPoint.X
    local errY = screen.Y - CachedAimPoint.Y
    local mag = Sqrt(errX * errX + errY * errY)
    if mag < 1.5 then
        return
    end

    local alpha = 1 / (math.max(Smoothness, 1) + 0.5)
    if mag < 32 then
        alpha *= Clamp(mag / 32, 0.35, 1)
    end
    alpha = Clamp(alpha, 0, 0.9)

    if AimMode == "mouse" then
        MoveMouse(errX * alpha, errY * alpha)
    else
        MoveCamera(aimPos, alpha)
    end
end

