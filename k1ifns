local SpeedConnection
local SpeedInputConnections = {}
local SpeedKeyW, SpeedKeyS, SpeedKeyA, SpeedKeyD = 0, 0, 0, 0

local function GetSpeedCharacter()
    local character = LocalPlayer.Character
    if not character then
        return nil
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
    if not humanoid or not root or humanoid.Health <= 0 then
        return nil
    end
    return character, humanoid, root
end

local function CalculateMoveVector(vec)
    local camera = Workspace.CurrentCamera
    if not camera then
        return Vector3.zero
    end
    local _, yaw = camera.CFrame:ToOrientation()
    return CFrame.Angles(0, yaw, 0):VectorToWorldSpace(vec)
end

local SpeedMethods = {
    Velocity = function(amount, movevec)
        local _, _, root = GetSpeedCharacter()
        if not root or movevec.Magnitude == 0 then
            return
        end
        local velocity = movevec.Unit * amount
        root.AssemblyLinearVelocity = Vector3.new(velocity.X, root.AssemblyLinearVelocity.Y, velocity.Z)
    end,
    Impulse = function(amount, movevec)
        local _, _, root = GetSpeedCharacter()
        if not root or movevec.Magnitude == 0 then
            return
        end
        local current = root.AssemblyLinearVelocity
        local target = movevec.Unit * amount
        local delta = Vector3.new(target.X - current.X, 0, target.Z - current.Z)
        root:ApplyImpulse(delta * root.AssemblyMass)
    end,
}

local function GetSpeedMoveVector(humanoid)
    local movevec = humanoid.MoveDirection
    if movevec.Magnitude > 0 then
        return movevec
    end

    local input = Vector3.new(SpeedKeyA + SpeedKeyD, 0, SpeedKeyW + SpeedKeyS)
    if input.Magnitude == 0 then
        return Vector3.zero
    end
    return CalculateMoveVector(input)
end

local function DisableSpeed()
    if SpeedConnection then
        SpeedConnection:Disconnect()
        SpeedConnection = nil
    end
    for _, connection in pairs(SpeedInputConnections) do
        connection:Disconnect()
    end
    table.clear(SpeedInputConnections)
    SpeedKeyW, SpeedKeyS, SpeedKeyA, SpeedKeyD = 0, 0, 0, 0
end

local function EnableSpeed()
    DisableSpeed()

    SpeedKeyW = UserInputService:IsKeyDown(Enum.KeyCode.W) and -1 or 0
    SpeedKeyS = UserInputService:IsKeyDown(Enum.KeyCode.S) and 1 or 0
    SpeedKeyA = UserInputService:IsKeyDown(Enum.KeyCode.A) and -1 or 0
    SpeedKeyD = UserInputService:IsKeyDown(Enum.KeyCode.D) and 1 or 0

    for _, eventName in ipairs({"InputBegan", "InputEnded"}) do
        SpeedInputConnections[eventName] = UserInputService[eventName]:Connect(function(input)
            if UserInputService:GetFocusedTextBox() then
                return
            end
            local pressed = eventName == "InputBegan"
            if input.KeyCode == Enum.KeyCode.W then
                SpeedKeyW = pressed and -1 or 0
            elseif input.KeyCode == Enum.KeyCode.S then
                SpeedKeyS = pressed and 1 or 0
            elseif input.KeyCode == Enum.KeyCode.A then
                SpeedKeyA = pressed and -1 or 0
            elseif input.KeyCode == Enum.KeyCode.D then
                SpeedKeyD = pressed and 1 or 0
            end
        end)
    end

    SpeedConnection = RunService.PreSimulation:Connect(function()
        if not Options.SpeedToggle or not Options.SpeedToggle.Value then
            return
        end

        local _, humanoid, root = GetSpeedCharacter()
        if not humanoid or not root then
            return
        end

        local state = humanoid:GetState()
        if state == Enum.HumanoidStateType.Climbing then
            return
        end

        local movevec = GetSpeedMoveVector(humanoid)
        local mode = Options.SpeedMode and Options.SpeedMode.Value or "Velocity"
        local amount = Options.SpeedAmount and Options.SpeedAmount.Value or 50
        local method = SpeedMethods[mode]
        if method then
            method(amount, movevec)
        end
    end)
end

