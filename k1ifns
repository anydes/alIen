        if AnyVisualEnabled() then
            UpdateDistances()
        end
    end
})

EspSettingsSection:AddDropdown("ChamsColor", {
    Title = "Color",
    Values = {"Red", "Green", "Blue", "Yellow", "Orange", "Purple", "Pink", "White", "Black", "Cyan"},
    Multi = false,
    Default = 1,
    Callback = function()
        local color = GetEspColor()
        for _, cham in pairs(ChamReference) do
            cham.FillColor = color
            cham.OutlineColor = DefaultOutlineColor
        end
        for _, nametag in pairs(NametagReference) do
            if nametag.Text then
                nametag.Text.Color = color
            end
        end
    end
})

