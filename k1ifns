FovCircle.Transparency = 0.35
FovCircle.ZIndex = 2
FovCircle.Visible = false

local LastFovCenter = Vector2.zero
local LastFovR = -1

local function HideFov()
    if FovCircle.Visible then
        FovCircle.Visible = false
        FovOutline.Visible = false
    end
end

local function DrawFov()
    if not ShowFov then
        HideFov()
        return
    end

    local center = CachedAimPoint
    local r = FovAt(LockedTarget ~= nil)
    if FovCircle.Visible and (center - LastFovCenter).Magnitude < 0.5 and r == LastFovR then
        return
    end
    LastFovCenter, LastFovR = center, r

    FovOutline.Position = center
    FovOutline.Radius = r
    FovOutline.Visible = true
    FovCircle.Position = center
    FovCircle.Radius = r
    FovCircle.Visible = true
end

