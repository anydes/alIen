local ColorMap = {
    Red = Color3.fromRGB(255, 50, 50),
    Green = Color3.fromRGB(50, 255, 50),
    Blue = Color3.fromRGB(50, 120, 255),
    Yellow = Color3.fromRGB(255, 255, 50),
    Orange = Color3.fromRGB(255, 140, 40),
    Purple = Color3.fromRGB(170, 50, 255),
    Pink = Color3.fromRGB(255, 100, 180),
    White = Color3.fromRGB(255, 255, 255),
    Black = Color3.fromRGB(30, 30, 30),
    Cyan = Color3.fromRGB(50, 255, 255),
}

local DefaultOutlineColor = Color3.fromRGB(255, 255, 255)
local FillTransparency = 0.5
local OutlineTransparency = 0.5
local DistanceCheckInterval = 0.15

local HealthGreen = Color3.fromRGB(0, 255, 140)
local HealthYellow = Color3.fromRGB(255, 200, 0)
local HealthRed = Color3.fromRGB(255, 70, 70)

local ChamReference = {}
local NametagReference = {}
local HealthReference = {}
local Tracked = {}
local PlayerConnections = {}
local SharedConnections = {}
local DistanceConnection
local DrawingConnection
local DistanceAccumulator = 0
local CachedLocalRoot
local MaxDistanceSq = 500 * 500
local CachedRenderDistance = 500
local VisualsActive = false

local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude
RayParams.IgnoreWater = true

local DrawingFont = 2
pcall(function()
    if Drawing and Drawing.Fonts then
        DrawingFont = Drawing.Fonts.UI or Drawing.Fonts.System or 2
    end
end)

local function GetGuiParent()
    if gethui then
        return gethui()
    end
    local ok, coreGui = pcall(function()
        return game:GetService("CoreGui")
    end)
    if ok and coreGui then
        return coreGui
    end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local Folder = Instance.new("Folder")
Folder.Name = "ChamsFolder"
Folder.Parent = GetGuiParent()

local function GetCamera()
    return Workspace.CurrentCamera
end

local function GetEspColor()
    local name = Options.ChamsColor and Options.ChamsColor.Value or "Red"
    return ColorMap[name] or ColorMap.Red
end

local function GetRoot(character)
    if not character then
        return nil
    end
    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("RootPart")
        or character.PrimaryPart
end

local function UpdateMaxDistance()
    CachedRenderDistance = Options.RenderDistance and Options.RenderDistance.Value or 500
    MaxDistanceSq = CachedRenderDistance * CachedRenderDistance
end

local function IsPriorityTarget(player)
    if not Options.PriorityOnly or not Options.PriorityOnly.Value then
        return true
    end
    if LocalPlayer.Team and player.Team and player.Team == LocalPlayer.Team then
        return false
    end
    return true
end

local function RenderWallsEnabled()
    return Options.RenderWalls and Options.RenderWalls.Value
end

local function ChamsEnabled()
    return Options.Chams and Options.Chams.Value
end

local function NametagsEnabled()
    return Options.Nametags and Options.Nametags.Value
end

local function HealthbarEnabled()
    return Options.Healthbar and Options.Healthbar.Value
end

local function AnyOverlayEnabled()
    return NametagsEnabled() or HealthbarEnabled()
end

local function AnyVisualEnabled()
    return ChamsEnabled() or AnyOverlayEnabled()
end

local function HealthColor(percent)
    if percent > 0.6 then
        return HealthGreen
    elseif percent > 0.3 then
        return HealthYellow
    end
    return HealthRed
end

local function HasLineOfSight(fromPos, toPos, character)
    RayParams.FilterDescendantsInstances = {LocalPlayer.Character, character, Folder}
    return Workspace:Raycast(fromPos, toPos - fromPos, RayParams) == nil
end

local function SafeRemoveDrawing(obj)
    if not obj then
        return
    end
    pcall(function()
        obj.Visible = false
        obj:Remove()
    end)
end

local function HideDrawings(...)
    for i = 1, select("#", ...) do
        local obj = select(i, ...)
        if obj then
            obj.Visible = false
        end
    end
end

local function RemoveNametag(player)
    local data = NametagReference[player]
    if not data then
        return
    end
    SafeRemoveDrawing(data.Text)
    SafeRemoveDrawing(data.Shadow)
    NametagReference[player] = nil
end

local function EnsureNametag(player, displayName)
    local data = NametagReference[player]
    if data and data.Text then
        data.Text.Text = displayName
        data.Shadow.Text = displayName
        data.Text.Color = GetEspColor()
        return data
    end

    RemoveNametag(player)

    local shadow = Drawing.new("Text")
    shadow.Center = true
    shadow.Outline = false
    shadow.Size = 14
    shadow.Font = DrawingFont
    shadow.Color = Color3.new(0, 0, 0)
    shadow.Transparency = 1
    shadow.Visible = false

    local text = Drawing.new("Text")
    text.Center = true
    text.Outline = true
    text.OutlineColor = Color3.new(0, 0, 0)
    text.Size = 14
    text.Font = DrawingFont
    text.Color = GetEspColor()
    text.Transparency = 1
    text.Text = displayName
    text.Visible = false

    shadow.Text = displayName

    data = {
        Text = text,
        Shadow = shadow,
    }
    NametagReference[player] = data
    return data
end

local function RemoveHealthbar(player)
    local data = HealthReference[player]
    if not data then
        return
    end
    SafeRemoveDrawing(data.Track)
    SafeRemoveDrawing(data.Fill)
    SafeRemoveDrawing(data.Border)
    SafeRemoveDrawing(data.Text)
    HealthReference[player] = nil
end

local function EnsureHealthbar(player)
    local data = HealthReference[player]
    if data and data.Track then
        return data
    end

    RemoveHealthbar(player)

    local track = Drawing.new("Square")
    track.Filled = true
    track.Thickness = 0
    track.Color = Color3.fromRGB(20, 20, 20)
    track.Transparency = 0.85
    track.Visible = false

    local border = Drawing.new("Square")
    border.Filled = false
    border.Thickness = 1
    border.Color = Color3.fromRGB(60, 60, 60)
    border.Transparency = 1
    border.Visible = false

    local fill = Drawing.new("Square")
    fill.Filled = true
    fill.Thickness = 0
    fill.Color = HealthGreen
    fill.Transparency = 1
    fill.Visible = false

    local text = Drawing.new("Text")
    text.Center = true
    text.Outline = true
    text.OutlineColor = Color3.new(0, 0, 0)
    text.Size = 12
    text.Font = DrawingFont
    text.Color = Color3.new(1, 1, 1)
    text.Transparency = 1
    text.Visible = false

    data = {
        Track = track,
        Border = border,
        Fill = fill,
        Text = text,
    }
    HealthReference[player] = data
    return data
end

local function ApplyChamStyle(cham)
    cham.DepthMode = Enum.HighlightDepthMode[RenderWallsEnabled() and "AlwaysOnTop" or "Occluded"]
    cham.FillColor = GetEspColor()
    cham.OutlineColor = DefaultOutlineColor
    cham.FillTransparency = FillTransparency
    cham.OutlineTransparency = OutlineTransparency
end

local function RemoveCham(player)
    local cham = ChamReference[player]
    if cham then
        cham:Destroy()
        ChamReference[player] = nil
    end
end

local function EnsureCham(player, character)
    local cham = ChamReference[player]
    if cham and cham.Parent then
        if cham.Adornee ~= character then
            cham.Adornee = character
        end
        return cham
    end

    cham = Instance.new("Highlight")
    cham.Name = "ChamsHighlight"
    cham.Adornee = character
    ApplyChamStyle(cham)
    cham.Enabled = false
    cham.Parent = Folder
    ChamReference[player] = cham
    return cham
end

local function RemoveEntity(player)
    RemoveCham(player)
    RemoveNametag(player)
    RemoveHealthbar(player)
    Tracked[player] = nil
end

local function CacheEntity(player)
    if player == LocalPlayer then
        return
    end

    if not IsPriorityTarget(player) then
        RemoveEntity(player)
        return
    end

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not humanoid or humanoid.Health <= 0 then
        RemoveEntity(player)
        return
    end

    local existing = Tracked[player]
    local inRange = existing and existing.InRange or false
    local hip = humanoid.HipHeight
    if hip <= 0 then
        hip = 2
    end

    Tracked[player] = {
        Character = character,
        Root = GetRoot(character),
        Head = character:FindFirstChild("Head"),
        Humanoid = humanoid,
        HipHeight = hip,
        Name = player.DisplayName ~= "" and player.DisplayName or player.Name,
        InRange = inRange,
    }

    if ChamsEnabled() then
        EnsureCham(player, character)
    else
        RemoveCham(player)
    end

    if NametagsEnabled() then
        EnsureNametag(player, Tracked[player].Name)
    else
        RemoveNametag(player)
    end

    if HealthbarEnabled() then
        EnsureHealthbar(player)
    else
        RemoveHealthbar(player)
    end
end

local function RefreshTracking()
    for _, player in Players:GetPlayers() do
        if player ~= LocalPlayer then
            CacheEntity(player)
        end
    end
end

local function UpdateDistances()
    CachedLocalRoot = GetRoot(LocalPlayer.Character)

    if not CachedLocalRoot then
        for player, data in pairs(Tracked) do
            data.InRange = false
            local cham = ChamReference[player]
            if cham then
                cham.Enabled = false
            end
        end
        return
    end

    local localPos = CachedLocalRoot.Position
    local chamsOn = ChamsEnabled()

    for player, data in pairs(Tracked) do
        local character = player.Character
        local root = data.Root
        if not root or root.Parent == nil then
            root = GetRoot(character)
            data.Root = root
            data.Character = character
            data.Head = character and character:FindFirstChild("Head")
            data.Humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if data.Humanoid and data.Humanoid.HipHeight > 0 then
                data.HipHeight = data.Humanoid.HipHeight
            end

            if character then
                if chamsOn then
                    EnsureCham(player, character)
                end
                if NametagsEnabled() then
                    EnsureNametag(player, data.Name or player.Name)
                end
                if HealthbarEnabled() then
                    EnsureHealthbar(player)
                end
            end
        end

        local inRange = false
        if root then
            local offset = localPos - root.Position
            local distSq = offset.X * offset.X + offset.Y * offset.Y + offset.Z * offset.Z
            inRange = distSq <= MaxDistanceSq
        end
        data.InRange = inRange

        local cham = ChamReference[player]
        if cham then
            cham.Enabled = chamsOn and inRange
        end
    end
end

local function UpdateDrawings()
    if not AnyOverlayEnabled() then
        return
    end

    local camera = GetCamera()
    if not camera then
        return
    end

    local nametagsOn = NametagsEnabled()
    local healthOn = HealthbarEnabled()
    local walls = RenderWallsEnabled()
    local color = GetEspColor()
    local camPos = camera.CFrame.Position
    local camLook = camera.CFrame.LookVector

    for player, data in pairs(Tracked) do
        local nametag = NametagReference[player]
        local health = HealthReference[player]
        local root = data.Root
        local head = data.Head
        local humanoid = data.Humanoid
        local character = data.Character

        if not data.InRange or not root or not humanoid or humanoid.Health <= 0 then
            if nametag then
                HideDrawings(nametag.Text, nametag.Shadow)
            end
            if health then
                HideDrawings(health.Track, health.Fill, health.Border, health.Text)
            end
            continue
        end

        local rootPos, onScreen = camera:WorldToViewportPoint(root.Position)
        if not onScreen or rootPos.Z <= 0 then
            if nametag then
                HideDrawings(nametag.Text, nametag.Shadow)
            end
            if health then
                HideDrawings(health.Track, health.Fill, health.Border, health.Text)
            end
            continue
        end

        if not walls and not HasLineOfSight(camPos, root.Position, character) then
            if nametag then
                HideDrawings(nametag.Text, nametag.Shadow)
            end
            if health then
                HideDrawings(health.Track, health.Fill, health.Border, health.Text)
            end
            continue
        end

        local hip = data.HipHeight or 2
        local topWorld = (CFrame.lookAlong(root.Position, camLook) * CFrame.new(2, hip, 0)).Position
        local bottomWorld = (CFrame.lookAlong(root.Position, camLook) * CFrame.new(-2, -hip - 1, 0)).Position
        local topPos = camera:WorldToViewportPoint(topWorld)
        local bottomPos = camera:WorldToViewportPoint(bottomWorld)

        local sizeX = topPos.X - bottomPos.X
        local sizeY = topPos.Y - bottomPos.Y
        local posX = rootPos.X - sizeX * 0.5
        local posY = rootPos.Y - sizeY * 0.5
        local distance = rootPos.Z
        local textSize = math.clamp(2200 / math.max(distance, 1), 10, 16)

        if nametagsOn and nametag then
            local tagWorld
            if head and head.Parent then
                tagWorld = head.Position + Vector3.new(0, head.Size.Y * 0.5 + 0.35, 0)
            else
                tagWorld = root.Position + Vector3.new(0, hip + 1.2, 0)
            end

            local tagPos, tagVisible = camera:WorldToViewportPoint(tagWorld)
            if tagVisible and tagPos.Z > 0 then
                local screen = Vector2.new(tagPos.X, tagPos.Y)
                nametag.Text.Text = data.Name
                nametag.Shadow.Text = data.Name
                nametag.Text.Color = color
                nametag.Text.Size = textSize
                nametag.Shadow.Size = textSize
                nametag.Text.Position = screen
                nametag.Shadow.Position = screen + Vector2.new(1, 1)
                nametag.Text.Visible = true
                nametag.Shadow.Visible = true
            else
                HideDrawings(nametag.Text, nametag.Shadow)
            end
        elseif nametag then
            HideDrawings(nametag.Text, nametag.Shadow)
        end

        if healthOn and health then
            local percent = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
            local barWidth = math.clamp(math.abs(sizeX) * 0.08, 3, 5)
            local barHeight = math.max(math.abs(sizeY), 12)
            local barX = posX - barWidth - 5
            local barY = posY
            local fillHeight = barHeight * percent
            local fillY = barY + (barHeight - fillHeight)

            health.Track.Size = Vector2.new(barWidth, barHeight)
            health.Track.Position = Vector2.new(barX, barY)
            health.Track.Visible = true

            health.Border.Size = Vector2.new(barWidth, barHeight)
            health.Border.Position = Vector2.new(barX, barY)
            health.Border.Visible = true

            health.Fill.Color = HealthColor(percent)
            health.Fill.Size = Vector2.new(barWidth, fillHeight)
            health.Fill.Position = Vector2.new(barX, fillY)
            health.Fill.Visible = percent > 0

            -- Vertical-style HP readout beside the bar
            health.Text.Text = string.format("%d/%d", math.floor(humanoid.Health), math.floor(humanoid.MaxHealth))
            health.Text.Size = math.clamp(textSize - 2, 9, 13)
            health.Text.Position = Vector2.new(barX - 2, barY + barHeight * 0.5)
            health.Text.Visible = true
        elseif health then
            HideDrawings(health.Track, health.Fill, health.Border, health.Text)
        end
    end
end

local function ClearAllVisuals()
    for player in pairs(ChamReference) do
        RemoveCham(player)
    end
    for player in pairs(NametagReference) do
        RemoveNametag(player)
    end
    for player in pairs(HealthReference) do
        RemoveHealthbar(player)
    end
    table.clear(Tracked)
end

local function DisconnectPlayerHooks()
    for _, connection in pairs(PlayerConnections) do
        connection:Disconnect()
    end
    table.clear(PlayerConnections)
end

local function EnsureDrawingLoop()
    if DrawingConnection then
        if not AnyOverlayEnabled() then
            DrawingConnection:Disconnect()
            DrawingConnection = nil
            for player in pairs(NametagReference) do
                RemoveNametag(player)
            end
            for player in pairs(HealthReference) do
                RemoveHealthbar(player)
            end
        end
        return
    end

    if not AnyOverlayEnabled() then
        return
    end

    DrawingConnection = RunService.RenderStepped:Connect(UpdateDrawings)
end

local function DisconnectShared()
    for _, connection in pairs(SharedConnections) do
        connection:Disconnect()
    end
    table.clear(SharedConnections)

    if DistanceConnection then
        DistanceConnection:Disconnect()
        DistanceConnection = nil
    end
    if DrawingConnection then
        DrawingConnection:Disconnect()
        DrawingConnection = nil
    end
    DistanceAccumulator = 0
    VisualsActive = false
end

local function HookPlayer(player)
    if player == LocalPlayer then
        return
    end

    PlayerConnections[player] = player.CharacterAdded:Connect(function()
        task.defer(function()
            if not AnyVisualEnabled() then
                return
            end
            CacheEntity(player)
            UpdateDistances()
        end)
    end)

    if player.Character then
        CacheEntity(player)
    end
end

local function StartVisuals()
    if VisualsActive then
        RefreshTracking()
        EnsureDrawingLoop()
        UpdateDistances()
        return
    end

    DisconnectShared()
    DisconnectPlayerHooks()
    ClearAllVisuals()
    UpdateMaxDistance()
    VisualsActive = true

    for _, player in Players:GetPlayers() do
        HookPlayer(player)
    end

    SharedConnections.PlayerAdded = Players.PlayerAdded:Connect(HookPlayer)
    SharedConnections.PlayerRemoving = Players.PlayerRemoving:Connect(function(player)
        if PlayerConnections[player] then
            PlayerConnections[player]:Disconnect()
            PlayerConnections[player] = nil
        end
        RemoveEntity(player)
    end)

    SharedConnections.LocalCharacter = LocalPlayer.CharacterAdded:Connect(function(character)
        CachedLocalRoot = GetRoot(character)
    end)
    CachedLocalRoot = GetRoot(LocalPlayer.Character)

    DistanceConnection = RunService.Heartbeat:Connect(function(dt)
        DistanceAccumulator += dt
        if DistanceAccumulator < DistanceCheckInterval then
            return
        end
        DistanceAccumulator = 0
        UpdateDistances()
    end)

    EnsureDrawingLoop()
    UpdateDistances()
end

local function StopVisualsIfIdle()
    if AnyVisualEnabled() then
        RefreshTracking()
        EnsureDrawingLoop()
        UpdateDistances()
        return
    end

    DisconnectShared()
    DisconnectPlayerHooks()
    ClearAllVisuals()
end

