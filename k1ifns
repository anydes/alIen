local AutoStrafeConnection
local AutoStrafeDirection = 1
local AutoStrafeFlipAccum = 0

local function IsAutoStrafeAttackHeld()
    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
        return true
    end

    for _, inputType in ipairs(UserInputService:GetConnectedGamepads()) do
        local ok, down = pcall(function()
            return UserInputService:IsGamepadButtonDown(inputType, Enum.KeyCode.ButtonR2)
        end)
        if ok and down then
            return true
        end
    end

    if UserInputService:IsKeyDown(Enum.KeyCode.ButtonR2) then
        return true
    end

    return false
end

local function DisableAutoStrafe()
    if AutoStrafeConnection then
        AutoStrafeConnection:Disconnect()
        AutoStrafeConnection = nil
    end
    AutoStrafeDirection = 1
    AutoStrafeFlipAccum = 0
end

local function EnableAutoStrafe()
    DisableAutoStrafe()

    AutoStrafeConnection = RunService.RenderStepped:Connect(function(dt)
        if not Options.AutoStrafe or not Options.AutoStrafe.Value then
            return
        end

        if not IsAutoStrafeAttackHeld() then
            return
        end

        AutoStrafeFlipAccum += dt
        if AutoStrafeFlipAccum >= 0.3 then
            AutoStrafeFlipAccum = 0
            AutoStrafeDirection *= -1
        end

        local _, humanoid, root = GetSpeedCharacter()
        if not humanoid or not root then
            return
        end

        humanoid:Move(Vector3.new(AutoStrafeDirection, 0, 0), true)

        local amount = Options.AutoStrafeAmount and Options.AutoStrafeAmount.Value
            or (Options.SpeedAmount and Options.SpeedAmount.Value)
            or 50
        local mode = Options.SpeedMode and Options.SpeedMode.Value or "Velocity"
        local method = SpeedMethods[mode]
        if not method then
            return
        end

        local camera = Workspace.CurrentCamera
        if not camera then
            return
        end

        local right = camera.CFrame.RightVector * AutoStrafeDirection
        local movevec = Vector3.new(right.X, 0, right.Z)
        if movevec.Magnitude > 0 then
            method(amount, movevec)
        end
    end)
end

