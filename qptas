		local GUARD_RADIUS = 10 -- only closest HoldingG player within this range

		Tabs.Maintab:Toggle({
			Flag = "AntiContestToggle",
			Title = "Anti Contest",
			Default = false,
			Callback = function(enabled)
				if enabled then
					local Players = game:GetService("Players")
					local RunService = game:GetService("RunService")

					local lp = Players.LocalPlayer
					local charName = lp.Name
					local charactersFolder = workspace:WaitForChild("Characters")
					local character = charactersFolder:WaitForChild(charName)
					local humanoidRootPart = workspace:WaitForChild("ProxyCharacter")
					local obj = character

					local actionActive = false
					local wasShooting = false
					local recoilActive = false
					local recoilElapsed = 0
					local recoilStartCF = nil
					local recoilGuarderRoot = nil
					local frameCount = 0
					local cachedGuarder = nil

					-- Closest player within GUARD_RADIUS who has HoldingG == true
					local function scanGuarder()
						local closest = nil
						local closestDist = GUARD_RADIUS
						local hrpPos = humanoidRootPart.Position
						local players = Players:GetPlayers()
						for i = 1, #players do
							local p = players[i]
							if p == lp then continue end
							local pChar = charactersFolder:FindFirstChild(p.Name)
							if not pChar then continue end
							if pChar:GetAttribute("HoldingG") ~= true then continue end
							local pRoot = pChar:FindFirstChild("HumanoidRootPart")
							if not pRoot then continue end
							local dist = (hrpPos - pRoot.Position).Magnitude
							if dist <= closestDist then
								closestDist = dist
								closest = pRoot
							end
						end
						cachedGuarder = closest
					end

					local function guarderStillValid(guarder)
						if not guarder or not guarder.Parent then return false end
						local pChar = guarder.Parent
						if pChar:GetAttribute("HoldingG") ~= true then return false end
						local dist = (humanoidRootPart.Position - guarder.Position).Magnitude
						return dist <= GUARD_RADIUS
					end

					local function getGoalCFrame(guarderCF, startCF)
						local look = guarderCF.LookVector
						local flatX, flatZ = look.X, look.Z
						if (flatX * flatX + flatZ * flatZ) < 1e-8 then
							local right = guarderCF.RightVector
							flatX, flatZ = right.X, right.Z
							if (flatX * flatX + flatZ * flatZ) < 1e-8 then return startCF end
						end
						local dir = Vector3.new(flatX, 0, flatZ).Unit
						local goalPos = startCF.Position + dir * recoilDistance
						return CFrame.new(goalPos, goalPos + startCF.LookVector)
					end

					local attrConn = obj.AttributeChanged:Connect(function(attr)
						if attr == "Action" then
							actionActive = (obj:GetAttribute("Action") == "Shooting")
						end
					end)

					local hbConn = RunService.Heartbeat:Connect(function(dt)
						frameCount = frameCount + 1
						if frameCount % GUARDER_CHECK_RATE == 0 then
							scanGuarder()
						end

						if actionActive and not wasShooting then
							local guarder = cachedGuarder
							if guarderStillValid(guarder) then
								recoilStartCF = humanoidRootPart.CFrame
								recoilGuarderRoot = guarder
								recoilElapsed = 0
								recoilActive = true
							end
						end

						if recoilActive then
							local gr = recoilGuarderRoot
							if not guarderStillValid(gr) then
								recoilActive = false
								recoilGuarderRoot = nil
							else
								recoilElapsed = recoilElapsed + dt
								local t = recoilElapsed * INV_TWEEN_TIME
								if t >= 1 then
									t = 1
									recoilActive = false
								end
								local inv = 1 - t
								local et = 1 - inv * inv
								local goalCF = getGoalCFrame(gr.CFrame, recoilStartCF)
								humanoidRootPart.CFrame = recoilStartCF:Lerp(goalCF, et)
							end
						end

						wasShooting = actionActive
					end)

					local ancestryConn = character.AncestryChanged:Connect(function()
						if not character:IsDescendantOf(game) then
							attrConn:Disconnect()
							hbConn:Disconnect()
							recoilActive = false
							recoilGuarderRoot = nil
							cachedGuarder = nil
						end
					end)

					_G.AntiContestConnections = {
						attrConn,
						hbConn,
						ancestryConn
					}
				else
					if _G.AntiContestConnections then
						for _, conn in ipairs(_G.AntiContestConnections) do
							conn:Disconnect()
						end
						_G.AntiContestConnections = nil
					end
				end
			end
		});

