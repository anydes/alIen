		-- CONFIGURATION
		-- ══════════════════════════════════════════════════════════════════
		-- Fully automatic release timing (no manual latency bias):
		--   1) α-β filter estimates meter position/velocity (Kalman-lite)
		--   2) Constant-accel prediction: y(t) = y + v t + ½ a t²
		--   3) Fire when time-to-TARGET ≤ lead τ
		--   4) τ = ping/2 + half-frame + residual
		--      residual is Smith-style: learned from (minY - TARGET) / |v|
		--      Sign: undershoot (minY too high) → τ too large → decrease τ
	
		local CONFIG = {
			TARGET_Y = -1.4,                -- Ideal meter Y at server register
			MIN_TARGET_Y = -1.6,
			MAX_TARGET_Y = -1.0,
	
			-- α-β filter (constant-velocity Kalman gain pair)
			AB_ALPHA = 0.45,                -- Position innovation weight
			AB_BETA = 0.12,                 -- Velocity innovation weight
			ACCEL_EMA = 0.30,               -- Accel smoother
			MIN_SAMPLES = 4,
			MAX_VELOCITY = 12,
			MAX_ACCEL = 50,
			OUTLIER_RATIO = 2.8,
	
			PERFECT_ZONE_Y = -1.4,
			PERFECT_HOLD_TIME = 0.5,
			MAX_SHOT_DURATION = 2.0,
	
			-- Lead-time learning (seconds)
			PING_SCALE = 0.5,               -- RTT → one-way
			RESIDUAL_MIN = -0.02,
			RESIDUAL_MAX = 0.12,
			TOLERANCE = 0.02,               -- |minY - TARGET| "perfect"
			LEARN_FLOOR = 0.06,             -- Min learning rate after warmup
	
			AUTO_TIME_ENABLED = false,
		}
	
		-- ══════════════════════════════════════════════════════════════════
		-- STATE
		-- ══════════════════════════════════════════════════════════════════
	
		local state = {
			prepared = false,
			started = false,
			fired = false,
			startTime = nil,
	
			-- α-β / kinematics
			filtY = nil,
			velocity = nil,       -- signed dy/dt (negative while filling)
			accel = nil,
			sampleCount = 0,
			lastMeasY = nil,
			lastTime = nil,
			lastVelocity = nil,
	
			minY = 0,
			fireSpeed = nil,      -- |v| at release (for learning)
			firedAtY = nil,
			leadUsed = nil,
	
			perfectEnterTime = nil,
			isPerfect = false,
			shotCount = 0,
		}
	
		local timing = {
			residual = 1 / 60,    -- Learned process/remote delay beyond ping/2
			pingEma = 0,          -- Smoothed one-way ping
			shots = 0,
			perfect = 0,
			errorEma = 0,
			calibrated = false,
		}
	
		-- ══════════════════════════════════════════════════════════════════
		-- LEAD TIME (fully automatic)
		-- ══════════════════════════════════════════════════════════════════
	
		local function sampleOneWayPing()
			local ok, ping = pcall(function()
				return player:GetNetworkPing()
			end)
			if ok and typeof(ping) == "number" and ping > 0 then
				return math.clamp(ping, 0, 0.4) * CONFIG.PING_SCALE
			end
			return timing.pingEma > 0 and timing.pingEma or 0.025
		end
	
		-- Lead = smoothed one-way ping + learned residual + half-frame
		local function getLeadTimeNow(dt)
			local oneWay = sampleOneWayPing()
			if timing.pingEma <= 0 then
				timing.pingEma = oneWay
			else
				timing.pingEma = timing.pingEma * 0.9 + oneWay * 0.1
			end
			local halfFrame = 0.5 * math.clamp(dt or 1 / 60, 1 / 240, 1 / 20)
			return timing.pingEma + timing.residual + halfFrame
		end
	
		-- Smith-style residual update from observed meter error
		-- y_server ≈ TARGET + v*(L - τ)  ⇒  err = minY - TARGET ≈ v*(L - τ)
		-- With v < 0: err > 0 (undershoot) ⇒ τ > L ⇒ decrease residual
		local function calibrateFromShot()
			if not state.fired or not state.fireSpeed then
				return
			end
	
			timing.shots = timing.shots + 1
			local err = state.minY - CONFIG.TARGET_Y
			timing.errorEma = timing.errorEma * 0.65 + err * 0.35
	
			local speed = state.fireSpeed
			if speed < 1e-4 then
				return
			end
	
			if math.abs(err) <= CONFIG.TOLERANCE then
				timing.perfect = timing.perfect + 1
				timing.calibrated = true
				return
			end
	
			-- Position error → time error (seconds). Correct sign: subtract.
			-- undershoot (err > 0) ⇒ fired too early ⇒ τ too large ⇒ decrease residual
			local timeErr = err / speed
			-- Fast early learning (≈ 1/n), then floor so it still tracks ping changes
			local alpha = math.max(CONFIG.LEARN_FLOOR, 1 / (timing.shots + 1))
			if timing.shots <= 3 then
				alpha = math.min(0.85, alpha * 1.8)
			end
	
			timing.residual = math.clamp(
				timing.residual - alpha * timeErr,
				CONFIG.RESIDUAL_MIN,
				CONFIG.RESIDUAL_MAX
			)
			timing.calibrated = timing.shots >= 2
		end
	
		local function reset()
			state.prepared = false
			state.started = false
			state.fired = false
			state.startTime = nil
			state.filtY = nil
			state.velocity = nil
			state.accel = nil
			state.sampleCount = 0
			state.lastMeasY = nil
			state.lastTime = nil
			state.lastVelocity = nil
			state.minY = 0
			state.fireSpeed = nil
			state.firedAtY = nil
			state.leadUsed = nil
			state.perfectEnterTime = nil
			state.isPerfect = false
		end
	
		-- ══════════════════════════════════════════════════════════════════
		-- α-β FILTER + ACCEL + TIME-TO-TARGET
		-- ══════════════════════════════════════════════════════════════════
	
		local function updateFilter(measY, now)
			if not state.lastTime then
				state.filtY = measY
				state.lastMeasY = measY
				state.lastTime = now
				state.velocity = 0
				return
			end
	
			local dt = now - state.lastTime
			if dt < 1e-4 then
				return
			end
	
			local dy = measY - (state.lastMeasY or measY)
			if math.abs(dy) < 1e-5 and state.sampleCount > 0 then
				-- Still advance time so filter doesn't freeze on flat frames
				local yPred = state.filtY + (state.velocity or 0) * dt
				state.filtY = yPred
				state.lastTime = now
				return
			end
	
			local rawV = dy / dt
			if math.abs(rawV) > CONFIG.MAX_VELOCITY then
				state.lastMeasY = measY
				state.lastTime = now
				return
			end
	
			if state.velocity and state.sampleCount >= CONFIG.MIN_SAMPLES then
				local expected = math.abs(state.velocity)
				if expected > 1e-3 and math.abs(rawV) > expected * CONFIG.OUTLIER_RATIO then
					state.lastMeasY = measY
					state.lastTime = now
					return
				end
			end
	
			-- α-β predict + update
			local v = state.velocity or rawV
			local yPred = (state.filtY or measY) + v * dt
			local resid = measY - yPred
			local yNew = yPred + CONFIG.AB_ALPHA * resid
			local vNew = v + (CONFIG.AB_BETA / dt) * resid
			vNew = math.clamp(vNew, -CONFIG.MAX_VELOCITY, CONFIG.MAX_VELOCITY)
	
			if state.lastVelocity then
				local rawA = (vNew - state.lastVelocity) / dt
				rawA = math.clamp(rawA, -CONFIG.MAX_ACCEL, CONFIG.MAX_ACCEL)
				if not state.accel then
					state.accel = rawA
				else
					local aa = CONFIG.ACCEL_EMA
					state.accel = state.accel * (1 - aa) + rawA * aa
				end
			end
	
			state.filtY = yNew
			state.velocity = vNew
			state.lastVelocity = vNew
			state.lastMeasY = measY
			state.lastTime = now
			state.sampleCount = state.sampleCount + 1
		end
	
		-- Solve ½ a t² + v t + (y - target) = 0 for smallest t ≥ 0
		local function timeToReach(y, target, v, a)
			local dy = target - y
			if y <= target then
				return 0
			end
			if not v then
				return nil
			end
	
			if not a or math.abs(a) < 1e-5 then
				if math.abs(v) < 1e-8 then
					return nil
				end
				local t = dy / v
				return t >= 0 and t or nil
			end
	
			local A = 0.5 * a
			local B = v
			local C = -dy
			local disc = B * B - 4 * A * C
			if disc < 0 then
				if math.abs(v) < 1e-8 then
					return nil
				end
				local t = dy / v
				return t >= 0 and t or nil
			end
	
			local sqrtD = math.sqrt(disc)
			local inv = 1 / (2 * A)
			local t1 = (-B - sqrtD) * inv
			local t2 = (-B + sqrtD) * inv
			local best = nil
			if t1 >= 0 then best = t1 end
			if t2 >= 0 and (not best or t2 < best) then best = t2 end
			return best
		end
	
		local function shouldFire(dt)
			if not CONFIG.AUTO_TIME_ENABLED then
				return false
			end
			if state.sampleCount < CONFIG.MIN_SAMPLES or not state.velocity or not state.filtY then
				return false
			end
			if state.velocity >= -1e-4 then
				return false
			end
	
			local y = state.filtY
			local target = CONFIG.TARGET_Y
			if y <= target then
				return true
			end
	
			local t = timeToReach(y, target, state.velocity, state.accel)
			if not t then
				return false
			end
	
			local lead = getLeadTimeNow(dt)
			state.leadUsed = lead
			return t <= lead
		end
	
		-- ══════════════════════════════════════════════════════════════════
		-- ACTIONS
		-- ══════════════════════════════════════════════════════════════════
	
		local function fire()
			if state.fired then return end
			state.fired = true
			state.firedAtY = state.filtY or state.lastMeasY
			state.fireSpeed = state.velocity and math.abs(state.velocity) or nil
			fireShoot()
		end
	
		local function checkPerfectZone(currentY, now)
			if currentY <= CONFIG.PERFECT_ZONE_Y then
				if not state.perfectEnterTime then
					state.perfectEnterTime = now
				elseif not state.isPerfect then
					if (now - state.perfectEnterTime) >= CONFIG.PERFECT_HOLD_TIME then
						state.isPerfect = true
					end
				end
			elseif state.perfectEnterTime then
				state.perfectEnterTime = nil
			end
		end
	
		-- ══════════════════════════════════════════════════════════════════
		-- MAIN LOOP
		-- ══════════════════════════════════════════════════════════════════
	
		local lastClock = os.clock()
	
		RunService.Heartbeat:Connect(function(dt)
			local now = os.clock()
			local frameDt = dt
			if typeof(frameDt) ~= "number" or frameDt <= 0 then
				frameDt = math.clamp(now - lastClock, 1 / 240, 1 / 20)
			end
			lastClock = now
	
			local enabled = verticalMeter.Enabled
	
			if enabled then
				if not state.prepared then
					state.prepared = true
					state.shotCount = state.shotCount + 1
				end
			else
				if state.prepared then
					if state.started and state.fired then
						calibrateFromShot()
					end
					reset()
				end
				return
			end
	
			local currentY = fillGradient.Offset.Y
	
			if state.prepared and not state.started and currentY < 0 then
				state.started = true
				state.startTime = now
				state.filtY = currentY
				state.lastMeasY = currentY
				state.lastTime = now
				state.velocity = 0
				state.minY = currentY
			end
	
			if state.started then
				if (now - state.startTime) >= CONFIG.MAX_SHOT_DURATION then
					if state.fired then
						calibrateFromShot()
					end
					reset()
					return
				end
			end
	
			if state.started then
				if currentY < state.minY then
					state.minY = currentY
				end
	
				if not state.fired then
					updateFilter(currentY, now)
					if shouldFire(frameDt) then
						fire()
					end
					checkPerfectZone(currentY, now)
				end
			end
		end)
	
