	-- Window Settings Tab
	do
		Tabs.WindowTab:Section({
			Title = "Window"
		});
		
		local themeValues = {};
		for name, _ in pairs(WindUI:GetThemes()) do
			table.insert(themeValues, name);
		end
		
		local themeDropdown = Tabs.WindowTab:Dropdown({
			Title = "Select Theme",
			Multi = false,
			AllowNone = false,
			Value = nil,
			Values = themeValues,
			Callback = function(theme)
				WindUI:SetTheme(theme);
			end
		});
		themeDropdown:Select(WindUI:GetCurrentTheme());
		
		-- Config Section
		Tabs.WindowTab:Section({
			Title = "Configuration"
		});
		
		local ConfigManager = Window.ConfigManager
		local AllConfigs = ConfigManager:AllConfigs()
		local ConfigName = AllConfigs[1]

		-- Auto-load first available config
		if ConfigName then
			local myConfig = ConfigManager:CreateConfig(ConfigName)
			myConfig:Load()
		end

		local ConfigNameInput = Tabs.WindowTab:Input({
			Title = "Config Name",
			Icon = "file-cog",
			Placeholder = "Enter config name...",
			Value = ConfigName,
			Callback = function(value)
				ConfigName = value
			end
		})

		Tabs.WindowTab:Space()
		
		local DefaultValue = table.find(AllConfigs, ConfigName) and ConfigName or nil

		local AllConfigsDropdown = Tabs.WindowTab:Dropdown({
			Title = "All Configs",
			Desc = "Select existing configs",
			Values = AllConfigs,
			Value = DefaultValue,
			Callback = function(value)
				ConfigName = value
				ConfigNameInput:Set(value)
			end
		})

		Tabs.WindowTab:Space()

		Tabs.WindowTab:Button({
			Title = "Save Config",
			Icon = "save",
			Justify = "Center",
			Callback = function()
				Window.CurrentConfig = ConfigManager:Config(ConfigName)
				if Window.CurrentConfig:Save() then
					WindUI:Notify({
						Title = "Config Saved",
						Desc = "Config '" .. ConfigName .. "' saved successfully",
						Icon = "check",
					})
				end
				
				AllConfigsDropdown:Refresh(ConfigManager:AllConfigs())
			end
		})

		Tabs.WindowTab:Space()

		Tabs.WindowTab:Button({
			Title = "Load Config",
			Icon = "refresh-cw",
			Justify = "Center",
			Callback = function()
				Window.CurrentConfig = ConfigManager:CreateConfig(ConfigName)
				if Window.CurrentConfig:Load() then
					WindUI:Notify({
						Title = "Config Loaded",
						Desc = "Config '" .. ConfigName .. "' loaded successfully",
						Icon = "check",
					})
				end
			end
		})

		Tabs.WindowTab:Space()

		Tabs.WindowTab:Button({
			Title = "Delete Config",
			Icon = "trash-2",
			Justify = "Center",
			Callback = function()
				if ConfigManager:DeleteConfig(ConfigName) then
					WindUI:Notify({
						Title = "Config Deleted",
						Desc = "Config '" .. ConfigName .. "' has been deleted",
						Icon = "trash",
					})
					AllConfigsDropdown:Refresh(ConfigManager:AllConfigs())
				else
					WindUI:Notify({
						Title = "Error",
						Desc = "Failed to delete config '" .. ConfigName .. "'",
						Icon = "x",
					})
				end
			end
		})
		
		-- Keybind Section
		Tabs.WindowTab:Section({
			Title = "Keybind"
		});
		
		Tabs.WindowTab:Keybind({
