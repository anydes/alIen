		local function startAutoContestV1()
					local Players = game:GetService("Players")
					local RunService = game:GetService("RunService")
					local lp = Players.LocalPlayer
					local characters = workspace:WaitForChild("Characters")
					local char = characters:WaitForChild(lp.Name)
					local proxyChar = workspace:WaitForChild("ProxyCharacter")

					-- Smooth closeout (legit look) — not a snap/teleport
					local MOVE_SPEED = 4
					local TURN_RATE = 12 -- rad-ish blend for facing
					local POS_SMOOTH = 14 -- exp approach rate
					local CONTEST_OFFSET = 0.1 -- regular auto contest stand-in-front
					local GLUE_OFFSET = 4 -- one-time TP/glue stand-in-front
					local RANGE = 15
					local MAX_Y_DELTA = 8
					local ARRIVE_EPS = 0.4
					local FACE_GLUE_DIST = 4 -- trigger one-time glue when this close
					local didFaceGlue = false -- one-shot glue per contest engagement

					local function isHoldingG()
						return char:GetAttribute("HoldingG") == true
					end

					local function getContestTarget()
						local bestRoot, bestDist = nil, RANGE
						local myPos = proxyChar.Position
						for _, p in ipairs(Players:GetPlayers()) do
							if p == lp then continue end
							local model = characters:FindFirstChild(p.Name)
							if not model then continue end
							local action = model:GetAttribute("Action")
							if action ~= "Shooting" and action ~= "Dunking" then continue end
							local root = model:FindFirstChild("HumanoidRootPart")
							if not root then continue end
							if math.abs(root.Position.Y - myPos.Y) > MAX_Y_DELTA then continue end
							local d = (Vector3.new(root.Position.X, myPos.Y, root.Position.Z) - myPos).Magnitude
							if d < bestDist then
								bestDist = d
								bestRoot = root
							end
						end
						return bestRoot, bestDist
					end

					-- In front of shooter facing; keep our Y. offset = GLUE_OFFSET or CONTEST_OFFSET
					local function contestGoalPos(targetRoot, myY, offset)
						local look = targetRoot.CFrame.LookVector
						local flat = Vector3.new(look.X, 0, look.Z)
						if flat.Magnitude < 1e-4 then
							local right = targetRoot.CFrame.RightVector
							flat = Vector3.new(right.X, 0, right.Z)
						end
						if flat.Magnitude < 1e-4 then
							return nil
						end
						flat = flat.Unit
						local vel = Vector3.zero
						pcall(function()
							vel = targetRoot.AssemblyLinearVelocity
						end)
						local lead = Vector3.new(vel.X, 0, vel.Z) * 0.08
						local targetXZ = Vector3.new(targetRoot.Position.X, myY, targetRoot.Position.Z) + lead
						return targetXZ + flat * offset
					end

					local function smoothFace(fromCF, lookAt, dt)
						local pos = fromCF.Position
						local flatLook = Vector3.new(lookAt.X - pos.X, 0, lookAt.Z - pos.Z)
						if flatLook.Magnitude < 0.05 then
							return fromCF
						end
						local goal = CFrame.new(pos, pos + flatLook.Unit)
						local alpha = 1 - math.exp(-TURN_RATE * dt)
						return fromCF:Lerp(goal, alpha)
					end

					local function hardFace(pos, lookAt)
						local flatLook = Vector3.new(lookAt.X - pos.X, 0, lookAt.Z - pos.Z)
						if flatLook.Magnitude < 0.05 then
							return CFrame.new(pos)
						end
						return CFrame.new(pos, pos + flatLook.Unit)
					end

					local function applyContest(dt)
						dt = math.clamp(dt or 1 / 60, 0, 0.05)

						if not proxyChar or not proxyChar.Parent or not char or not char.Parent then
							return
						end
						if not isHoldingG() then
							didFaceGlue = false
							return
						end

						local targetRoot = getContestTarget()
						if not targetRoot or not targetRoot.Parent then
							didFaceGlue = false
							return
						end

						local myPos = proxyChar.Position
						local myY = myPos.Y
						local lookAt = Vector3.new(targetRoot.Position.X, myY, targetRoot.Position.Z)
						local distToShooter = (lookAt - Vector3.new(myPos.X, myY, myPos.Z)).Magnitude

						-- Glue snap only when Stop Rim Run is enabled
						if stopRimRunEnabled and not didFaceGlue and distToShooter <= FACE_GLUE_DIST then
							local gluePos = contestGoalPos(targetRoot, myY, GLUE_OFFSET)
							if gluePos then
								proxyChar.CFrame = hardFace(Vector3.new(gluePos.X, myY, gluePos.Z), lookAt)
								didFaceGlue = true
								return
							end
						end

						local goalPos = contestGoalPos(targetRoot, myY, CONTEST_OFFSET)
						if not goalPos then return end

						local toGoal = Vector3.new(goalPos.X - myPos.X, 0, goalPos.Z - myPos.Z)
						local dist = toGoal.Magnitude

						local nextPos
						if dist > ARRIVE_EPS and toGoal.Magnitude > 1e-4 then
							local dir = toGoal.Unit
							local step = math.min(dist, MOVE_SPEED * dt)
							local stepped = myPos + dir * step
							local alpha = 1 - math.exp(-POS_SMOOTH * dt)
							local blended = stepped:Lerp(Vector3.new(goalPos.X, myY, goalPos.Z), alpha * 0.15)
							nextPos = Vector3.new(blended.X, myY, blended.Z)
						else
							local alpha = 1 - math.exp(-POS_SMOOTH * dt)
							local settled = myPos:Lerp(Vector3.new(goalPos.X, myY, goalPos.Z), alpha)
							nextPos = Vector3.new(settled.X, myY, settled.Z)
						end

						local base = CFrame.new(nextPos) * (proxyChar.CFrame - proxyChar.CFrame.Position)
						local faced = smoothFace(base, lookAt, dt)
						proxyChar.CFrame = faced
					end

					pcall(function()
						RunService:UnbindFromRenderStep(AUTO_CONTEST_BIND_NAME)
					end)
					RunService:BindToRenderStep(AUTO_CONTEST_BIND_NAME, Enum.RenderPriority.Last.Value + 100, applyContest)
		end

		local function startAutoContestV2()
			local Players = game:GetService("Players")
			local RunService = game:GetService("RunService")
			local lp = Players.LocalPlayer
			local char = workspace.Characters:WaitForChild(lp.Name)
			local proxyChar = workspace:WaitForChild("ProxyCharacter")
			local LERP_SPEED = 0.014
			local FRONT_OFFSET = 0.1
			local RANGE = 20
			local LOCKED_Y = proxyChar.Position.Y

			local function isHoldingG()
				return char:GetAttribute("HoldingG") == true
			end

			local function getClosestPlayer()
				local closest
				local dist = math.huge
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= lp then
						local charModel = workspace.Characters:FindFirstChild(p.Name)
						if charModel and charModel:FindFirstChild("HumanoidRootPart") then
							local root = charModel.HumanoidRootPart
							local d = (proxyChar.Position - root.Position).Magnitude
							if d < dist then
								dist = d
								closest = p
							end
						end
					end
				end
				return closest, dist
			end

			local function isActionShootingOrDunking(player)
				local charModel = workspace.Characters:FindFirstChild(player.Name)
				if not charModel then return false end
				local action = charModel:GetAttribute("Action")
				return action == "Shooting" or action == "Dunking"
			end

			_G.autoContestConnection = RunService.Heartbeat:Connect(function()
				if not isHoldingG() then return end
				local targetPlayer, dist = getClosestPlayer()
				if not targetPlayer then return end
				if dist > RANGE then return end
				if not isActionShootingOrDunking(targetPlayer) then return end
				local targetRoot = workspace.Characters[targetPlayer.Name].HumanoidRootPart
				local facePos = targetRoot.Position + (targetRoot.CFrame.LookVector * FRONT_OFFSET)
				facePos = Vector3.new(facePos.X, LOCKED_Y, facePos.Z)
				local goal = CFrame.new(
					facePos,
					Vector3.new(targetRoot.Position.X, LOCKED_Y, targetRoot.Position.Z)
				)
				proxyChar.CFrame = proxyChar.CFrame:Lerp(goal, LERP_SPEED)
			end)
		end

		local function startAutoContest()
			stopAutoContest()
			if autoContestMode == "v2" then
				startAutoContestV2()
			else
				startAutoContestV1()
			end
		end

