		local autoContestMode = "v1"
		local autoContestActive = false
		local AUTO_CONTEST_BIND_NAME = "VantaAutoContestDominant"
		local AUTO_CONTEST_FREEZE_ACTION = "VantaContestFreezeMove"
		local v1Contesting = false
		local v1ControlsDisabled = false
		local v1OldMoveFunction = nil
