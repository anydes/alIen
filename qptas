					local proxy = workspace:WaitForChild("ProxyCharacter")
					local cam = workspace.CurrentCamera
					-- Track input
					local keys = {}
					local gVec = Vector3.new(0,0,0)
					local mVec = Vector3.new(0,0,0)
					-- Keyboard mapping (fixed forward/backward)
					local keyMap = {
						[Enum.KeyCode.W] = Vector3.new(0,0,1),   -- Forward
						[Enum.KeyCode.S] = Vector3.new(0,0,-1),  -- Backward
						[Enum.KeyCode.A] = Vector3.new(-1,0,0),  -- Left
						[Enum.KeyCode.D] = Vector3.new(1,0,0),   -- Right
					}
					-- Keyboard input
					local inputBeganConn = uis.InputBegan:Connect(function(i, gp)
						if gp then return end
						if keyMap[i.KeyCode] then
							keys[i.KeyCode] = true
						end
					end)
					local inputEndedConn = uis.InputEnded:Connect(function(i)
						if keyMap[i.KeyCode] then
							keys[i.KeyCode] = nil
						end
					end)
					-- Gamepad input
					local gamepadConn = uis.InputChanged:Connect(function(i)
						if i.UserInputType == Enum.UserInputType.Gamepad1 or i.UserInputType == Enum.UserInputType.Gamepad2 then
							if i.KeyCode == Enum.KeyCode.Thumbstick1 then
								gVec = Vector3.new(i.Position.X, 0, i.Position.Y)
							end
						end
					end)
					-- Mobile input
					local mobileConn = uis.InputChanged:Connect(function(i)
						if i.UserInputType == Enum.UserInputType.Touch then
							if i.UserInputState == Enum.UserInputState.Change then
								mVec = Vector3.new(i.Position.X, 0, i.Position.Y)
							end
						end
					end)
					-- Function to get true camera-relative move direction (like Roblox)
					local function GetDir()
						local m = Vector3.new(0,0,0)
						
						-- Keyboard
						for k, _ in pairs(keys) do
							m = m + keyMap[k]
						end
						
						-- Controller
						m = m + gVec
						
						-- Mobile
						m = m + mVec
						
						if m.Magnitude > 0 then
							m = m.Unit
							
							-- Apply camera rotation like Roblox does
							local cf = workspace.CurrentCamera.CFrame
							local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z).Unit
							local right = cf.RightVector
							
							-- Map input vector to camera-relative vector
							local d = right * m.X + look * m.Z
							return d.Magnitude > 0 and d.Unit or Vector3.new(0,0,0)
						end
						
						return Vector3.new(0,0,0)
					end
					-- Apply movement boost based on camera-relative move direction
					local renderConn = rs.RenderStepped:Connect(function(dt)
						-- Only apply speed boost if Action attribute is "Shooting"
						local act = char:GetAttribute("Action")
						if act ~= "Shooting" then return end
						
						local dir = GetDir()
						
						if dir.Magnitude > 0 then
							proxy.CFrame = proxy.CFrame + (dir * spd * dt)
						end
					end)
					
					-- Store connections for cleanup
					_G.ShotGlideConnections = {
						inputBeganConn,
						inputEndedConn,
						gamepadConn,
						mobileConn,
						renderConn
					}
				else
					-- Disconnect all connections when toggle is disabled
					if _G.ShotGlideConnections then
						for _, conn in ipairs(_G.ShotGlideConnections) do
							conn:Disconnect()
						end
						_G.ShotGlideConnections = nil
					end
				end
			end
