					local function CalculateGuardPosition(ballHolderRoot, rimPosition, myRoot)
						local GUARD_DISTANCE = getgenv().GuardDistanceValue or 5.5
						local PREDICTION_FACTOR = getgenv().PredictionFactorValue or 0.2
						
						local ballPos = ballHolderRoot.Position
						local myPos = myRoot.Position
						local velocity = ballHolderRoot.AssemblyLinearVelocity
						local horizontalVelocity = Vector3.new(velocity.X, 0, velocity.Z)
						local speed = horizontalVelocity.Magnitude
						
						local ballToRim = rimPosition - ballPos
						local horizontalBallToRim = Vector3.new(ballToRim.X, 0, ballToRim.Z)
						
						if horizontalBallToRim.Magnitude == 0 then
							return ballPos
						end
						
						local laneDirection = horizontalBallToRim.Unit
						local baseGuardPos = ballPos + (laneDirection * GUARD_DISTANCE)
						
						local predictionScale = math.clamp(speed / 20, 0, 1) * PREDICTION_FACTOR
						local predictedOffset = horizontalVelocity * predictionScale
						local finalPos = baseGuardPos + predictedOffset
						
						local predictedBallPos = ballPos + predictedOffset
						local correctedDirection = (rimPosition - predictedBallPos)
						local horizontalCorrectedDir = Vector3.new(correctedDirection.X, 0, correctedDirection.Z)
						
						if horizontalCorrectedDir.Magnitude > 0 then
							finalPos = predictedBallPos + (horizontalCorrectedDir.Unit * GUARD_DISTANCE)
						end
						
						finalPos = Vector3.new(finalPos.X, ballPos.Y, finalPos.Z)
						return finalPos
					end

					-- Attribute-based guarding detection
					local function is_guarding_by_attribute(char)
						if not char then return false end
						local holdingG = char:GetAttribute("HoldingG")
						return holdingG == true
					end

					-- Find closest rim
					local function get_closest_rim(rims, position)
						local dist, closest = math.huge, nil
						for _, rim in ipairs(rims) do
							local d = (rim:GetPivot().Position - position).Magnitude
							if d < dist then
								dist = d
								closest = rim
							end
						end
						return closest
					end

					-- Rim detection
					local rims = {}
					for _, obj in workspace:GetDescendants() do
						if obj:IsA("MeshPart") and obj.Name == "Rim" then
							table.insert(rims, obj)
						end
					end

					-- Track pressed keys
					local pressedKeys = {
						[Enum.KeyCode.W] = false,
						[Enum.KeyCode.A] = false,
						[Enum.KeyCode.S] = false,
						[Enum.KeyCode.D] = false,
					}

					local lastForwardKey = nil
					local lastRightKey = nil

					local function releaseAllKeys()
						for key, _ in pairs(pressedKeys) do
							pcall(function()
								virtualinputmanager:SendKeyEvent(false, key, false, game)
							end)
							pressedKeys[key] = false
						end
						lastForwardKey = nil
						lastRightKey = nil
					end

					local function sendKey(key, isDown)
						if pressedKeys[key] == isDown then return end
						pcall(function()
							virtualinputmanager:SendKeyEvent(isDown, key, false, game)
						end)
						pressedKeys[key] = isDown
					end

					-- Movement state
					local lastGuardState = false
					local wasControllingMovement = false

					-- WalkSpeed enforcement
					local walkSpeedConnection = nil

					local function startWalkSpeedEnforcement()
						if walkSpeedConnection then return end
						
						local char = get_char(client)
						if not char then return end
						
						-- Save original WalkSpeed when first starting to guard
						if originalWalkSpeed == nil then
							originalWalkSpeed = char:GetAttribute("WalkSpeed")
						end
						
						walkSpeedConnection = RunService.Heartbeat:Connect(function()
							local char = get_char(client)
							if not char then return end
							
							local WALK_SPEED = getgenv().MoveSpeedValue or 20
							if char:GetAttribute("WalkSpeed") ~= WALK_SPEED then
								char:SetAttribute("WalkSpeed", WALK_SPEED)
							end
						end)
					end

					local function stopWalkSpeedEnforcement()
						if walkSpeedConnection then
							walkSpeedConnection:Disconnect()
							walkSpeedConnection = nil
						end
						
						-- Restore original WalkSpeed
						if originalWalkSpeed ~= nil then
							local char = get_char(client)
							if char then
								char:SetAttribute("WalkSpeed", originalWalkSpeed)
							end
							originalWalkSpeed = nil
						end
					end

					local function move_to_position_wasd(char, targetPosition)
						local root = char:FindFirstChild("HumanoidRootPart")
						if not root then 
							releaseAllKeys()
							return 
						end
						
						local TOLERANCE = 0.3
						
						local direction = (targetPosition - root.Position)
						local horizontalDirection = Vector3.new(direction.X, 0, direction.Z)
						
						if horizontalDirection.Magnitude <= TOLERANCE then
							releaseAllKeys()
							return
						end

						local moveVector = horizontalDirection.Unit
						local cam = workspace.CurrentCamera
						if not cam then 
							releaseAllKeys()
							return 
						end

						local camCF = cam.CFrame
						local camRight = camCF.RightVector
						local camLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit

						local forward = moveVector:Dot(camLook)
						local right = moveVector:Dot(camRight)

						local activateThreshold = 0.2
						local deactivateThreshold = 0.08

						local newForwardKey = lastForwardKey
						if forward > activateThreshold then
							newForwardKey = Enum.KeyCode.W
						elseif forward < -activateThreshold then
							newForwardKey = Enum.KeyCode.S
						elseif math.abs(forward) < deactivateThreshold then
							newForwardKey = nil
						end

						if newForwardKey ~= lastForwardKey then
							if lastForwardKey then sendKey(lastForwardKey, false) end
							if newForwardKey then sendKey(newForwardKey, true) end
							lastForwardKey = newForwardKey
						end

						local newRightKey = lastRightKey
						if right > activateThreshold then
							newRightKey = Enum.KeyCode.D
						elseif right < -activateThreshold then
							newRightKey = Enum.KeyCode.A
						elseif math.abs(right) < deactivateThreshold then
							newRightKey = nil
						end

						if newRightKey ~= lastRightKey then
							if lastRightKey then sendKey(lastRightKey, false) end
							if newRightKey then sendKey(newRightKey, true) end
							lastRightKey = newRightKey
						end
					end

					-- AUTO GUARD LOOP
					local loopConnection = RunService.Heartbeat:Connect(function()
						local char = get_char(client)
						local root = get_root(char)
						local hum = get_hum(char)

						if not (char and root and hum) then 
							releaseAllKeys()
							stopWalkSpeedEnforcement()
							wasControllingMovement = false
							return 
						end

						local currentGuardState = is_guarding_by_attribute(char)

						if lastGuardState and not currentGuardState then
							releaseAllKeys()
							stopWalkSpeedEnforcement()
							wasControllingMovement = false
						end

						lastGuardState = currentGuardState

						local player_with_ball = (function()
							local basketballsFolder = workspace:FindFirstChild("Basketballs")
							if not basketballsFolder then return nil end
							
							local closestBall = nil
							local closestBallDist = math.huge
							
							for _, ball in ipairs(basketballsFolder:GetChildren()) do
								if ball:IsA("BasePart") then
									local d = (ball.Position - root.Position).Magnitude
									if d <= BALL_DETECTION_RANGE and d < closestBallDist then
										closestBallDist = d
										closestBall = ball
									end
								end
							end
							
							if not closestBall then return nil end
							
							local chars = workspace:FindFirstChild("Characters")
							if not chars then return nil end
							
							local closestPlayer = nil
							local closestPlayerDist = math.huge
							
							for _, plr in players:GetPlayers() do
								if plr == client then continue end
								local p_char = chars:FindFirstChild(plr.Name)
								local p_root = p_char and p_char:FindFirstChild("HumanoidRootPart")
								
								if p_root then
									local distToBall = (p_root.Position - closestBall.Position).Magnitude
									
									if distToBall < closestPlayerDist then
										closestPlayerDist = distToBall
										closestPlayer = p_char
									end
								end
							end
							
							if not closestPlayer then return nil end
							
							local attributesFolder = closestPlayer:FindFirstChild("Attributes")
							local basketball = attributesFolder and attributesFolder:FindFirstChild("Basketball")
							local has_ball = basketball and basketball:IsA("ObjectValue")
							
							if has_ball then
								return closestPlayer
							else
								return nil
							end
						end)()

						if player_with_ball and currentGuardState then
							wasControllingMovement = true
							startWalkSpeedEnforcement()

							local ballHolderRoot = player_with_ball:FindFirstChild("HumanoidRootPart")
							if ballHolderRoot then
								local closest_rim = get_closest_rim(rims, ballHolderRoot.Position)
								if closest_rim then
									local rimPosition = closest_rim:GetPivot().Position
									local target_position = CalculateGuardPosition(ballHolderRoot, rimPosition, root)
									move_to_position_wasd(char, target_position)
								end
							end
						else
							if wasControllingMovement then
								releaseAllKeys()
								stopWalkSpeedEnforcement()
								wasControllingMovement = false
							end
						end
					end)

					-- Store connections for cleanup
					getgenv().AutoGuardLoopConnection = loopConnection
					getgenv().AutoGuardWalkSpeedConnection = walkSpeedConnection
					getgenv().AutoGuardReleaseKeys = releaseAllKeys
					getgenv().AutoGuardStopWalkSpeed = stopWalkSpeedEnforcement

				else
					-- Cleanup when toggle is off
					if getgenv().AutoGuardLoopConnection then
						getgenv().AutoGuardLoopConnection:Disconnect()
						getgenv().AutoGuardLoopConnection = nil
					end
					if getgenv().AutoGuardWalkSpeedConnection then
						getgenv().AutoGuardWalkSpeedConnection:Disconnect()
						getgenv().AutoGuardWalkSpeedConnection = nil
					end
					if getgenv().AutoGuardStopWalkSpeed then
						getgenv().AutoGuardStopWalkSpeed()
						getgenv().AutoGuardStopWalkSpeed = nil
					end
					if getgenv().AutoGuardReleaseKeys then
						getgenv().AutoGuardReleaseKeys()
						getgenv().AutoGuardReleaseKeys = nil
					end
				end
			end
		})

