		local CONFIG = {
			FIRE_AT_Y = -1.35,              -- Y position to fire at
			LATENCY_COMPENSATION = 0.025,   -- Combined latency bias (25ms)
			VELOCITY_SAMPLES = 3,           -- Samples for velocity averaging
			PERFECT_ZONE_Y = -1.4,          -- Perfect shot threshold
			PERFECT_HOLD_TIME = 0.5,        -- Seconds to hold for perfect
			MAX_SHOT_DURATION = 2.0,        -- Maximum shot duration in seconds
			
			-- Auto Improver Settings
			AUTO_IMPROVE = true,            -- Toggle auto-improvement on/off
			TARGET_Y = -1.4,                -- Ideal Y position we want to hit
			IMPROVE_RATE = 0.025,           -- Learning rate (0-1): how much to trust each shot's calculation
			IMPROVE_TOLERANCE = 0.05,       -- How close to target is "good enough"
			MIN_FIRE_Y = -1.6,              -- Lowest FIRE_AT_Y can go
			MAX_FIRE_Y = -1.0,              -- Highest FIRE_AT_Y can go
			
			-- Auto Time Settings
			AUTO_TIME_ENABLED = false,      -- Toggle for auto time feature
