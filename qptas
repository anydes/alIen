		-- ══════════════════════════════════════════════════════════════════
	
		local state = {
			-- Flags
			prepared = false,
			started = false,
			fired = false,
			
			-- Timing
			startTime = nil,
			
			-- Velocity tracking
			velocitySamples = {},
			velocity = nil,
			
			-- Meter tracking
			lastY = nil,
			lastTime = nil,
			minY = 0,
			
			-- Perfect shot
			perfectEnterTime = nil,
			isPerfect = false,
			
			shotCount = 0,
			
			-- Auto Improver tracking
			firedAtY = nil,
		}
	
		-- Auto Improver stats
		local improverStats = {
			totalShots = 0,
			perfectShots = 0,
			adjustments = 0,
		}
	
		-- ══════════════════════════════════════════════════════════════════
		-- AUTO IMPROVER
		-- ══════════════════════════════════════════════════════════════════
	
		local function autoImprove()
			if not CONFIG.AUTO_IMPROVE or not state.fired or not state.firedAtY then
				return
			end
			
			improverStats.totalShots = improverStats.totalShots + 1
			
			local error = state.minY - CONFIG.TARGET_Y
			local shotVelocity = state.velocity or 0
			
			if math.abs(error) <= CONFIG.IMPROVE_TOLERANCE then
				improverStats.perfectShots = improverStats.perfectShots + 1
				return
			end
			
			if shotVelocity <= 0 then
				return
			end
			
			local idealFireY = state.firedAtY + error
			local adjustment = (idealFireY - CONFIG.FIRE_AT_Y) * CONFIG.IMPROVE_RATE
			
			CONFIG.FIRE_AT_Y = CONFIG.FIRE_AT_Y + adjustment
			CONFIG.FIRE_AT_Y = math.max(CONFIG.MIN_FIRE_Y, math.min(CONFIG.MAX_FIRE_Y, CONFIG.FIRE_AT_Y))
			
			improverStats.adjustments = improverStats.adjustments + 1
		end
	
		local function reset()
			state.prepared = false
			state.started = false
			state.fired = false
			state.startTime = nil
			state.velocitySamples = {}
			state.velocity = nil
			state.lastY = nil
			state.lastTime = nil
			state.minY = 0
			state.perfectEnterTime = nil
			state.isPerfect = false
			state.firedAtY = nil
		end
	
		-- ══════════════════════════════════════════════════════════════════
		-- VELOCITY & PREDICTION
		-- ══════════════════════════════════════════════════════════════════
	
		local function updateVelocity(deltaY, deltaTime)
			if deltaY <= 0 or deltaTime <= 0 then return end
			
			local v = deltaY / deltaTime
			local samples = state.velocitySamples
			
			table.insert(samples, v)
			if #samples > CONFIG.VELOCITY_SAMPLES then
				table.remove(samples, 1)
			end
			
			local sum = 0
			for i = 1, #samples do
				sum = sum + samples[i]
			end
			state.velocity = sum / #samples
		end
	
		local function shouldFire(currentY, currentTime)
			if not CONFIG.AUTO_TIME_ENABLED then
				return false
			end
			
			if not state.velocity or state.velocity <= 0 then
				return false
			end
			
			if currentY <= CONFIG.FIRE_AT_Y then
				return true
			end
			
			local distance = math.abs(CONFIG.FIRE_AT_Y - currentY)
			local timeToTarget = distance / state.velocity
			
			return timeToTarget <= CONFIG.LATENCY_COMPENSATION
		end
	
		-- ══════════════════════════════════════════════════════════════════
		-- ACTIONS
		-- ══════════════════════════════════════════════════════════════════
	
		local function fire(currentY)
			if state.fired then return end
			state.fired = true
			state.firedAtY = currentY
			
			fireShoot()
		end
	
		local function checkPerfectZone(currentY, now)
			if currentY <= CONFIG.PERFECT_ZONE_Y then
				if not state.perfectEnterTime then
					state.perfectEnterTime = now
				elseif not state.isPerfect then
					local held = now - state.perfectEnterTime
					if held >= CONFIG.PERFECT_HOLD_TIME then
						state.isPerfect = true
					end
				end
			elseif state.perfectEnterTime then
				state.perfectEnterTime = nil
			end
		end
	
		-- ══════════════════════════════════════════════════════════════════
		-- MAIN LOOP
		-- ══════════════════════════════════════════════════════════════════
	
		RunService.Heartbeat:Connect(function()
			local now = os.clock()
			local enabled = verticalMeter.Enabled
			
			if enabled then
				if not state.prepared then
					state.prepared = true
					state.shotCount = state.shotCount + 1
				end
			else
				if state.prepared then
					if state.started then
						autoImprove()
					end
					reset()
				end
				return
			end
			
			local currentY = fillGradient.Offset.Y
			
			if state.prepared and not state.started and currentY < 0 then
				state.started = true
				state.startTime = now
				state.lastY = currentY
				state.lastTime = now
				state.minY = currentY
			end
			
			if state.started then
				local duration = now - state.startTime
				if duration >= CONFIG.MAX_SHOT_DURATION then
					autoImprove()
					reset()
					return
				end
			end
			
			if state.started and not state.fired then
				if currentY < state.minY then
					state.minY = currentY
				end
				
				if currentY ~= state.lastY and state.lastTime then
					local deltaY = math.abs(currentY - state.lastY)
					local deltaTime = now - state.lastTime
					
					updateVelocity(deltaY, deltaTime)
					
					state.lastY = currentY
					state.lastTime = now
				end
				
				if shouldFire(currentY, now) then
					fire(currentY)
				end
				
				checkPerfectZone(currentY, now)
			end
		end)
	
