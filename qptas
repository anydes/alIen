		-- ══════════════════════════════════════════════════════════════════
		-- Meter Y → Median → EMA V/A → Smoothed latency → Predict → Fire
		-- FIRE_AT_Y is user bias only. Prediction owns ping/FPS.
		-- ══════════════════════════════════════════════════════════════════

		local RunService = game:GetService("RunService")
		local Players = game:GetService("Players")
		local Stats = game:GetService("Stats")

		local player = Players.LocalPlayer
		local hrp = workspace.Characters[player.Name].HumanoidRootPart
		local verticalMeter = hrp:WaitForChild("VerticalMeter")
		local fillGradient = verticalMeter.Meter_Fill.FillGradient

		-- ══════════════════════════════════════════════════════════════════
		-- CONFIGURATION
		-- ══════════════════════════════════════════════════════════════════

		local CONFIG = {
			FIRE_AT_Y = -1.35,              -- User release bias (Offset slider)
			TARGET_Y = -1.4,
			PERFECT_ZONE_Y = -1.4,
			PERFECT_HOLD_TIME = 0.5,
			MAX_SHOT_DURATION = 2.0,

			VELOCITY_ALPHA = 0.28,
			MEDIAN_WINDOW = 5,
			ACCEL_SMOOTH = 0.15,
			MAX_VELOCITY = 12,
			MAX_ACCEL = 40,
			MAX_ACCEL_CONTRIB = 0.06,        -- Cap 1/2 at^2 so accel can't yank fires

			PING_SCALE = 0.5,
			PROCESS_DELAY = 0.008,
			MIN_PREDICT_DELAY = 0.010,
			MAX_PREDICT_DELAY = 0.12,        -- Was 0.22 -- lag spikes were over-leading
			FRAME_EMA_ALPHA = 0.15,
			SPIKE_DT_MULT = 2.5,             -- Skip fire decision on lag frames

			MIN_SAMPLES = 4,
			MIN_CONFIDENCE = 0.82,
			MIN_SPEED = 0.15,               -- Don't fire on near-zero velocity

			-- Residual time bias only (seconds). Does NOT move FIRE_AT_Y.
			AUTO_IMPROVE = true,
			LEARN_GAIN = 0.12,
			MAX_BIAS = 0.035,
			MAX_BIAS_STEP = 0.008,
			IMPROVE_TOLERANCE = 0.04,

			AUTO_TIME_ENABLED = false,
		}

		-- ══════════════════════════════════════════════════════════════════
		-- STATE
		-- ══════════════════════════════════════════════════════════════════

		local state = {
			prepared = false,
			started = false,
			fired = false,

			elapsed = 0,
			perfectHold = 0,

			rawVelocitySamples = {},
			velocity = nil,
			acceleration = 0,
			confidence = 0,
			sampleCount = 0,

			lastY = nil,
			sinceSample = 0,
			minY = 0,
			firedAtY = nil,
			predictedAtFire = nil,

			isPerfect = false,
			shotCount = 0,
		}

		-- Persists across shots (intentional), but capped + only residual timing
		local timing = {
			pingEma = 0.035,
			frameEma = 1 / 60,
			bias = 0, -- learned extra lead (seconds); positive = fire earlier
		}

		-- ══════════════════════════════════════════════════════════════════
		-- LATENCY (smoothed -- never use a raw spike frame as the lead)
		-- ══════════════════════════════════════════════════════════════════

		local function sampleOneWayPing()
			local ok, ping = pcall(function()
				return player:GetNetworkPing()
			end)
			if ok and typeof(ping) == "number" and ping > 0 then
				return math.clamp(ping, 0, 0.35) * CONFIG.PING_SCALE
			end
			local ok2, ms = pcall(function()
				return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
			end)
			if ok2 and typeof(ms) == "number" and ms > 0 then
				return math.clamp(ms / 1000, 0, 0.35) * CONFIG.PING_SCALE
			end
			return timing.pingEma
		end

		local function updateFrameEma(dt)
			local alpha = CONFIG.FRAME_EMA_ALPHA
			-- Soft-reject spikes so one hitch doesn't poison the EMA
			if dt > timing.frameEma * CONFIG.SPIKE_DT_MULT and timing.frameEma > 0 then
				dt = timing.frameEma * 1.25
			end
			timing.frameEma = timing.frameEma * (1 - alpha) + dt * alpha
			timing.frameEma = math.clamp(timing.frameEma, 1 / 240, 1 / 25)
			return timing.frameEma
		end

		local function getPredictionDelay(dt)
			local oneWay = sampleOneWayPing()
			timing.pingEma = timing.pingEma * 0.9 + oneWay * 0.1

			local frameDelay = updateFrameEma(dt)

			return math.clamp(
				timing.pingEma + frameDelay + CONFIG.PROCESS_DELAY + timing.bias,
				CONFIG.MIN_PREDICT_DELAY,
				CONFIG.MAX_PREDICT_DELAY
			)
		end

		local function isLagSpike(dt)
			return dt > timing.frameEma * CONFIG.SPIKE_DT_MULT
		end

		-- ══════════════════════════════════════════════════════════════════
		-- FILTERS & PHYSICS
		-- ══════════════════════════════════════════════════════════════════

		local function medianOf(samples)
			local n = #samples
			if n == 0 then
				return nil
			end
			local sorted = {}
			for i = 1, n do
				sorted[i] = samples[i]
			end
			table.sort(sorted)
			if n % 2 == 1 then
				return sorted[math.ceil(n / 2)]
			end
			return (sorted[n / 2] + sorted[n / 2 + 1]) * 0.5
		end

		local function updatePhysics(rawVelocity, dt)
			if dt <= 0 then
				return
			end

			rawVelocity = math.clamp(rawVelocity, -CONFIG.MAX_VELOCITY, CONFIG.MAX_VELOCITY)

			local samples = state.rawVelocitySamples
			table.insert(samples, rawVelocity)
			if #samples > CONFIG.MEDIAN_WINDOW then
				table.remove(samples, 1)
			end

			local filtered = medianOf(samples)
			if not filtered then
				return
			end

			if state.velocity and state.sampleCount >= CONFIG.MIN_SAMPLES then
				local expected = math.abs(state.velocity)
				if expected > 0.08 and math.abs(filtered) > expected * 2.2 then
					state.confidence = math.max(0, state.confidence * 0.6)
					return
				end
			end

			local newVelocity
			if not state.velocity then
				newVelocity = filtered
				state.acceleration = 0
			else
				local accel = (filtered - state.velocity) / math.max(dt, 1 / 240)
				accel = math.clamp(accel, -CONFIG.MAX_ACCEL, CONFIG.MAX_ACCEL)
				-- Only blend accel once we have a stable velocity estimate
				if state.sampleCount >= CONFIG.MIN_SAMPLES then
					state.acceleration =
						state.acceleration * (1 - CONFIG.ACCEL_SMOOTH) + accel * CONFIG.ACCEL_SMOOTH
				else
					state.acceleration = 0
				end

				local alpha = CONFIG.VELOCITY_ALPHA
				newVelocity = alpha * filtered + (1 - alpha) * state.velocity
			end

			local velocityError = math.abs(filtered - (state.velocity or filtered))
			local speed = math.abs(newVelocity)
			local stability = speed > 1e-4 and math.clamp(1 - (velocityError / (speed + 0.2)), 0, 1) or 0
			local sampleBoost = math.clamp((state.sampleCount - 1) / (CONFIG.MIN_SAMPLES + 3), 0, 1)
			state.confidence = math.clamp(stability * 0.65 + sampleBoost * 0.35, 0, 1)

			state.velocity = newVelocity
			state.sampleCount = state.sampleCount + 1
		end

		-- Y(t) = Y0 + Vt + 1/2 at^2  (accel term hard-capped)
		local function predictY(currentY, delay)
			local v = state.velocity or 0
			local a = state.acceleration or 0
			local accelTerm = 0.5 * a * delay * delay
			accelTerm = math.clamp(accelTerm, -CONFIG.MAX_ACCEL_CONTRIB, CONFIG.MAX_ACCEL_CONTRIB)
			return currentY + (v * delay) + accelTerm
		end

		local function shouldFire(currentY, dt)
			if not CONFIG.AUTO_TIME_ENABLED then
				return false
			end
			if state.sampleCount < CONFIG.MIN_SAMPLES or not state.velocity then
				return false
			end
			if state.velocity >= -CONFIG.MIN_SPEED then
				return false
			end
			if state.confidence < CONFIG.MIN_CONFIDENCE then
				return false
			end
			-- Never decide on a hitch frame -- prediction delay would explode
			if isLagSpike(dt) then
				return false
			end

			local delay = getPredictionDelay(dt)
			local predicted = predictY(currentY, delay)
			state.predictedAtFire = predicted

			return predicted <= CONFIG.FIRE_AT_Y
		end

		-- ══════════════════════════════════════════════════════════════════
		-- AUTO IMPROVER -- residual TIME bias only (not FIRE_AT_Y drift)
		-- Uses predicted release vs threshold. Never uses post-release depth.
		-- ══════════════════════════════════════════════════════════════════

		local function autoImprove()
			if not CONFIG.AUTO_IMPROVE or not state.fired or state.firedAtY == nil then
				return
			end
			if not state.velocity or state.velocity >= -CONFIG.MIN_SPEED then
				return
			end

			-- Where the shot likely registered ~= predicted Y at fire
			local registered = state.predictedAtFire or state.firedAtY
			local err = registered - CONFIG.FIRE_AT_Y

			local speed = math.abs(state.velocity)
			if speed < 1e-4 then
				return
			end

			-- Convert position error -> time via velocity (v is negative).
			-- timeErr > 0 means we need more lead (fire earlier)
			local timeErr = -err / speed

			if math.abs(timeErr) < (CONFIG.IMPROVE_TOLERANCE / speed) then
				return
			end

			local step = math.clamp(timeErr * CONFIG.LEARN_GAIN, -CONFIG.MAX_BIAS_STEP, CONFIG.MAX_BIAS_STEP)
			timing.bias = math.clamp(timing.bias + step, -CONFIG.MAX_BIAS, CONFIG.MAX_BIAS)
		end

		local function reset()
			state.prepared = false
			state.started = false
			state.fired = false
			state.elapsed = 0
			state.perfectHold = 0
			state.rawVelocitySamples = {}
			state.velocity = nil
			state.acceleration = 0
			state.confidence = 0
			state.sampleCount = 0
			state.lastY = nil
			state.sinceSample = 0
			state.minY = 0
			state.firedAtY = nil
			state.predictedAtFire = nil
			state.isPerfect = false
		end

		-- ══════════════════════════════════════════════════════════════════
		-- ACTIONS
		-- ══════════════════════════════════════════════════════════════════

		local function fire(currentY)
			if state.fired then
				return
			end
			state.fired = true
			state.firedAtY = currentY
			-- Freeze predicted outcome at the decision -- don't let later meter motion rewrite learning
			fireShoot()
		end

		local function checkPerfectZone(currentY, dt)
			if currentY <= CONFIG.PERFECT_ZONE_Y then
				state.perfectHold = state.perfectHold + dt
				if not state.isPerfect and state.perfectHold >= CONFIG.PERFECT_HOLD_TIME then
					state.isPerfect = true
				end
			else
				state.perfectHold = 0
			end
		end

		-- ══════════════════════════════════════════════════════════════════
		-- MAIN LOOP
		-- ══════════════════════════════════════════════════════════════════

		RunService.Heartbeat:Connect(function(dt)
			dt = math.clamp(dt or (1 / 60), 1 / 240, 1 / 15)

			local enabled = verticalMeter.Enabled

			if enabled then
				if not state.prepared then
					state.prepared = true
					state.shotCount = state.shotCount + 1
				end
			else
				if state.prepared then
					if state.started and state.fired then
						autoImprove()
					end
					reset()
				end
				return
			end

			local currentY = fillGradient.Offset.Y

			if state.prepared and not state.started and currentY < 0 then
				state.started = true
				state.elapsed = 0
				state.lastY = currentY
				state.sinceSample = 0
				state.minY = currentY
			end

			if not state.started then
				return
			end

			state.elapsed = state.elapsed + dt
			if state.elapsed >= CONFIG.MAX_SHOT_DURATION then
				-- Timed out -- do not learn from partial shots
				reset()
				return
			end

			-- Track minY only pre-fire; learning never uses post-fire depth
			if not state.fired and currentY < state.minY then
				state.minY = currentY
			end

			if not state.fired then
				-- On lag spikes, still advance time but don't ingest wild velocity
				if not isLagSpike(dt) then
					state.sinceSample = state.sinceSample + dt
					if state.lastY ~= nil and currentY ~= state.lastY and state.sinceSample > 1e-4 then
						local sampleDt = state.sinceSample
						local rawVelocity = (currentY - state.lastY) / sampleDt
						updatePhysics(rawVelocity, sampleDt)
						state.lastY = currentY
						state.sinceSample = 0
					elseif state.lastY == nil then
						state.lastY = currentY
						state.sinceSample = 0
					end
				else
					-- Resync sample anchor after hitch so next delta isn't huge
					state.lastY = currentY
					state.sinceSample = 0
					state.confidence = math.max(0, state.confidence * 0.7)
				end

				if shouldFire(currentY, dt) then
					fire(currentY)
				end

				checkPerfectZone(currentY, dt)
			end
		end)

		-- ══════════════════════════════════════════════════════════════════
		-- UI CONTROLS
		-- ══════════════════════════════════════════════════════════════════

		Tabs.Maintab:Toggle({
			Title = "Auto Time",
			Default = false,
			Callback = function(value)
				CONFIG.AUTO_TIME_ENABLED = value
				if value then
					timing.pingEma = sampleOneWayPing()
